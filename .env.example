# Copy this file to .env and fill in your values. Never commit .env.
# cp .env.example .env

# --- n8n (Phase 1) ---
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# --- Telegram bot (Phase 2) ---
# Get this from @BotFather in Telegram: /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Database (Phase 3) ---
DATABASE_PATH=./data/opportunity.db

# --- Rudra AI providers ---
# OpenAI is tried first when set, then Gemini, then local Ollama.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash