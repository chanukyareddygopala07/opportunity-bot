# Copy this file to .env and fill in your values. Never commit .env.
# cp .env.example .env

# --- n8n (scheduler) ---
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
# Basic auth for the local n8n editor (REQUIRED by docker-compose):
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# --- Pipeline trigger token (REQUIRED) ---
# Shared secret: n8n sends it as X-Run-Token; API/webhook require it for
# /run, /crawl and admin stats endpoints. Generate: openssl rand -hex 32
RUN_TOKEN=

# --- Web app sessions (REQUIRED in docker) ---
# Generate: openssl rand -hex 32
SESSION_SECRET=
# Cookie Secure flag: auto (default; Secure when HTTPS detected) | force | never
COOKIE_SECURE=auto

# --- Admin bootstrap ---
# The named existing user is granted the admin role at startup.
# Leave empty on public deployments until your account exists.
ADMIN_USERNAME=admin

# --- Database ---
DATABASE_PATH=./data/opportunity.db

# --- OAuth sign-in (optional) ---
# Register callback URLs at <OAUTH_REDIRECT_BASE>/auth/google/callback and
# <OAUTH_REDIRECT_BASE>/auth/github/callback
OAUTH_REDIRECT_BASE=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Rudra AI providers ---
# Provider order for Rudra chat & streaming:
#   Groq → OpenAI → Gemini → local Ollama
# GROQ_API_KEY is an OpenAI-compatible endpoint (https://api.groq.com/v1).
# Point GROQ_BASE_URL at another OpenAI-compatible API if needed.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Telegram notifications (optional; SEND_TELEGRAM=false disables) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Crawler tuning ---
REQUEST_TIMEOUT_MS=20000
MAX_RETRIES=3
PER_DOMAIN_DELAY_MS=1500
MAX_PAGES_PER_SOURCE=10
MAX_RESULTS_PER_SOURCE=1000
